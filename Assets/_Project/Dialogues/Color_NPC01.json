{
  "dialogues": [
    {
      "id": "Color_NPC01_1_01",
      "character": "Color_NPC01",
      "content": "生面孔呢，从哪来的？",
      "nextId": "Color_NPC01_1_02"
    },
    {
      "id": "Color_NPC01_1_02",
      "character": "protagonist",
      "content": "...海的另一头。",
      "nextId": "Color_NPC01_1_03"
    },
    {
      "id": "Color_NPC01_1_03",
      "character": "Color_NPC01",
      "content": "啊...不想说吗...",
      "nextId": "Color_NPC01_1_04"
    },
    {
      "id": "Color_NPC01_1_04",
      "character": "Color_NPC01",
      "content": "不想说也没关系，来看看我家的大眼鱼吧，今早刚捞上来的，新鲜的很。",
      "nextId": "Color_NPC01_1_05"
    },
    {
      "id": "Color_NPC01_1_05",
      "character": "protagonist",
      "content": "不用了，谢谢。",
      "effects": [
        { "SetNpcDialogueStage": 2 }
      ],
      "nextId": "end"
    },


    {
      "id": "Color_NPC01_2_01",
      "character": "Color_NPC01",
      "content": "回来了？我们岛上的风景还不错吧？要不要来条鱼？",
      "nextId": "Color_NPC01_2_02"
    },
    {
      "id": "Color_NPC01_2_02",
      "character": "protagonist",
      "content": "嗯...不需要。",
      "nextId": "Color_NPC01_2_03"
    },
    {
      "id": "Color_NPC01_2_03",
      "character": "Color_NPC01",
      "content": "什么时候想买了随时来！",
      "effects": [
        { "SetNpcDialogueStage": 3 }
      ],
      "nextId": "end"
    },

   
    {
      "id": "Color_NPC01_3_01",
      "character": "Color_NPC01",
      "content": "来了？来一条吧！",
      "nextId": "Color_NPC01_3_02"
    },
    {
      "id": "Color_NPC01_3_02",
      "character": "protagonist",
      "content": "好。",
      "nextId": "Color_NPC01_3_03"
    },
    {
      "id": "Color_NPC01_3_03",
      "character": "Color_NPC01",
      "content": "好嘞！",
      "nextId": "Color_NPC01_3_04"
    },
    {
      "id": "Color_NPC01_3_04",
      "character": "Color_NPC01",
      "content": "您拿好，慢走！",
      "nextId": "Color_NPC01_3_05"
    },
    {
      "id": "Color_NPC01_3_05",
      "character": "protagonist",
      "content": "（买这鱼是要干嘛......）",
      "nextId": "Color_NPC01_3_06"
    },
    {
      "id": "Color_NPC01_3_06",
      "character": "narrator",
      "content": "获得道具“大眼鱼”",
      "effects": [
        { "SetNpcDialogueStage": 4 },
        { "GetItem": "item01" }
      ],
      "nextId": "end"
    },

  
    {
      "id": "Color_NPC01_4_01",
      "character": "Color_NPC01",
      "content": "（正忙着整理东西）",
      "nextId": "Color_NPC01_4_02"
    },
    {
      "id": "Color_NPC01_4_02",
      "character": "protagonist",
      "content": "（还是不要打扰好了...）",
      "nextId": "end"
    }
  ]
}