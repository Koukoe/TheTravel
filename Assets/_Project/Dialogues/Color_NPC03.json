{
  "dialogues": [
    {
      "id": "Color_NPC03_1_01",
      "character": "Color_NPC03",
      "content": "小姑娘...小姑娘，麻烦过来一下。",
      "nextId": "Color_NPC03_1_02"
    },
    {
      "id": "Color_NPC03_1_02",
      "character": "protagonist",
      "content": "是在叫我吗？",
      "nextId": "Color_NPC03_1_03"
    },
    {
      "id": "Color_NPC03_1_03",
      "character": "protagonist",
      "content": "有什么事吗老太太？",
      "nextId": "Color_NPC03_1_04"
    },
    {
      "id": "Color_NPC03_1_04",
      "character": "Color_NPC03",
      "content": "小姑娘，你是从外面来的吧？",
      "nextId": "Color_NPC03_1_05"
    },
    {
      "id": "Color_NPC03_1_05",
      "character": "protagonist",
      "content": "是...怎么了吗？",
      "nextId": "Color_NPC03_1_06"
    },
    {
      "id": "Color_NPC03_1_06",
      "character": "Color_NPC03",
      "content": "小姑娘，你有没有见过一个比奶奶我高一些，晒得黑黑的，整天笑得很开心的姑娘？那是我的孙女妮娜，半年前偷偷跟着船跑了，到现在还没个音信。",
      "nextId": "Color_NPC03_1_07"
    },
    {
      "id": "Color_NPC03_1_07",
      "character": "protagonist",
      "content": "不...没有。",
      "nextId": "Color_NPC03_1_08"
    },
    {
      "id": "Color_NPC03_1_08",
      "character": "Color_NPC03",
      "content": "好吧...要是你有见到她，麻烦跟她说一声，就说奶奶能理解她想出去看看的心情，奶奶不怪她，只希望她能够平平安安的就好。",
      "nextId": "Color_NPC03_1_09"
    },
    {
      "id": "Color_NPC03_1_09",
      "character": "protagonist",
      "content": "好，我记住了。",
      "nextId": "Color_NPC03_1_10"
    },
    {
      "id": "Color_NPC03_1_10",
      "character": "Color_NPC03",
      "content": "心善的小姑娘，谢谢你。愿波尼克保佑你！",
      "effects": [
        { "SetNpcDialogueStage": 2 }
      ],
      "nextId": "end"
    },

    {
      "id": "Color_NPC03_2_01",
      "character": "Color_NPC03",
      "content": "（正安详地熟睡中）",
      "nextId": "Color_NPC03_2_02"
    },
    {
      "id": "Color_NPC03_2_02",
      "character": "protagonist",
      "content": "（还是不要打扰好了...）",
      "nextId": "end"
    }
  ]
}